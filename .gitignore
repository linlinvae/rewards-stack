# Only reviewed root entries are eligible for publication. Local deliveries,
# reports, upstream caches and new root files remain private until reviewed.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/README.md
!/README_DEPLOY.md
!/README_NAS.md
!/README_PUSHPLUS.md
!/README_RELIABILITY.md
!/ACCOUNT_DELETE.md
!/WEB_LOGIN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/UPSTREAM_LOCK.json
!/compose.yaml
!/compose.source.yaml
!/package.json
!/package-lock.json
!/docker/
!/scripts/
!/tests/
!/dashboard-zh-CN/
!/localization/
!/docs/
!/LICENSES/

# Historical helpers were written for a particular machine, one-time SSH
# grants or dated release archives. Keep them locally; never package them.
/scripts/nas-*
!/scripts/nas-rewards-interface-check.cjs
/scripts/check-nas-*
/scripts/inspect-nas-*
/scripts/validate-nas-*
/scripts/serve-*
/scripts/prepare-*
/scripts/package-*.mjs
!/scripts/package-public.mjs
/scripts/manual-login.mjs
/scripts/import-session.mjs
/tests/*-release.py

# Credentials, runtime state, dependencies, generated evidence and archives.
.env
.env.*
!.env.example
.npmrc
.pypirc
config/
sessions/
data/
backups/
upstream/
.test-work/
reports/
node_modules/
dist/
coverage/
test-results/
playwright-report/
__pycache__/
*.pyc
*.log
*.tap
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.sha256
*.sqlite*
*.db*
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
authorized_keys
known_hosts
*storage-state*.json
*storageState*.json
*credentials*.json
*credentials*.txt
*login.txt
*.har
*.dump
*.bak
*.orig
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.pdf
.DS_Store
Thumbs.db
